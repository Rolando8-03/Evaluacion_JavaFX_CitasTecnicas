<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="556" prefWidth="1140" styleClass="workspace" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="ni.edu.uam.citastecnicas.controller.CitaController">
 <children>
  <Label layoutX="18" layoutY="18" styleClass="section-title" text="Agenda de atención técnica" />
  <Label fx:id="lblTotal" layoutX="18" layoutY="46" styleClass="subtitle" text="0 citas encontradas" />
  <ComboBox fx:id="cmbFiltroEstado" layoutX="18" layoutY="77" prefWidth="150" promptText="Estado" />
  <DatePicker fx:id="dpFiltroFecha" layoutX="180" layoutY="77" prefWidth="175" promptText="Todas las fechas" />
  <Button layoutX="367" layoutY="77" onAction="#filtrar" styleClass="secondary" text="Aplicar filtros" />
  <Button layoutX="493" layoutY="77" onAction="#limpiarFiltros" styleClass="plain" text="Limpiar filtros" />
  <TableView fx:id="tblCitas" AnchorPane.bottomAnchor="19" AnchorPane.leftAnchor="18" AnchorPane.rightAnchor="348" AnchorPane.topAnchor="125">
   <columns>
    <TableColumn fx:id="colId" prefWidth="50" text="ID" />
    <TableColumn fx:id="colCliente" prefWidth="206" text="Cliente" />
    <TableColumn fx:id="colFecha" prefWidth="99" text="Fecha" />
    <TableColumn fx:id="colHora" prefWidth="70" text="Hora" />
    <TableColumn fx:id="colServicio" prefWidth="167" text="Servicio" />
    <TableColumn fx:id="colEstado" prefWidth="113" text="Estado" />
   </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
  </TableView>
  <AnchorPane prefWidth="310" styleClass="form-card" AnchorPane.bottomAnchor="19" AnchorPane.rightAnchor="18" AnchorPane.topAnchor="18">
   <children>
    <Label fx:id="lblFormulario" layoutX="19" layoutY="19" styleClass="form-title" text="Nueva cita técnica" />
    <Label layoutX="19" layoutY="57" text="Cliente *" />
    <ComboBox fx:id="cmbCliente" layoutX="19" layoutY="80" prefWidth="272" promptText="Seleccioná un cliente" />
    <Label layoutX="19" layoutY="121" text="Fecha *" />
    <Label layoutX="193" layoutY="121" text="Hora * (HH:mm)" />
    <DatePicker fx:id="dpFecha" layoutX="19" layoutY="144" prefWidth="161" promptText="Fecha de cita" />
    <TextField fx:id="txtHora" layoutX="192" layoutY="144" prefWidth="99" promptText="09:30" />
    <Label layoutX="19" layoutY="185" text="Tipo de servicio *" />
    <TextField fx:id="txtServicio" layoutX="19" layoutY="208" prefWidth="272" promptText="Mantenimiento / reparación" />
    <Label layoutX="19" layoutY="249" text="Descripción *" />
    <TextArea fx:id="txtDescripcion" layoutX="19" layoutY="272" prefHeight="73" prefWidth="272" promptText="Describí el trabajo solicitado" wrapText="true" />
    <Label layoutX="19" layoutY="356" text="Estado *" />
    <ComboBox fx:id="cmbEstado" layoutX="19" layoutY="379" prefWidth="272" />
    <Button layoutX="19" layoutY="425" onAction="#guardar" prefWidth="132" styleClass="primary" text="Registrar cita" />
    <Button fx:id="btnEditar" layoutX="159" layoutY="425" onAction="#editar" prefWidth="132" styleClass="secondary,compact-button" text="Guardar cambios" />
    <Button layoutX="19" layoutY="467" onAction="#nuevo" prefWidth="153" styleClass="plain" text="Nueva / limpiar" />
    <Button fx:id="btnEliminar" layoutX="181" layoutY="467" onAction="#eliminar" prefWidth="110" styleClass="danger" text="Eliminar" />
   </children>
  </AnchorPane>
 </children>
</AnchorPane>
